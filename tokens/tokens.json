{
  "$description": "9MM Pro design tokens — machine-readable mirror of colors.css and fonts.css",
  "brand": {
    "name": "9MM Pro",
    "styledName": "9MM.PRO",
    "tagline": "Decentralized. Efficient. Yours.",
    "domains": ["9mm.pro", "dex.9mm.pro", "9x.9mm.pro", "claim.9mm.pro", "xch.9mm.pro"],
    "social": { "twitter": "@9mm_pro", "telegram": "t.me/ninemmpro" }
  },
  "color": {
    "light": {
      "$description": "Softened parchment (v1.1.0) — no pure white; light is opt-in, dark is the default scheme",
      "ink": {
        "950": { "$value": "#f1ebdb", "$type": "color", "$description": "page background" },
        "900": { "$value": "#f8f4e7", "$type": "color", "$description": "card (never pure white)" },
        "800": { "$value": "#ece5d0", "$type": "color", "$description": "popover / input" },
        "700": { "$value": "#e5dcc4", "$type": "color", "$description": "secondary" },
        "600": { "$value": "#ded3b6", "$type": "color", "$description": "muted" }
      },
      "fg": {
        "default": { "$value": "#171208", "$type": "color" },
        "muted": { "$value": "#3a3226", "$type": "color" },
        "subtle": { "$value": "#675d48", "$type": "color" }
      },
      "brass": {
        "default": { "$value": "#7d672c", "$type": "color" },
        "hot": { "$value": "#997f38", "$type": "color" },
        "deep": { "$value": "#54431a", "$type": "color" }
      },
      "semantic": {
        "warn": { "$value": "#b5891a", "$type": "color" },
        "danger": { "$value": "#b8443d", "$type": "color" },
        "success": { "$value": "#157a3d", "$type": "color" }
      },
      "hairline": { "$value": "rgba(125, 103, 44, 0.32)", "$type": "color" },
      "hairlineBrass": { "$value": "rgba(125, 103, 44, 0.55)", "$type": "color" },
      "bodyGradTop": { "$value": "#ece5d2", "$type": "color" },
      "bodyGradBottom": { "$value": "#efe9d8", "$type": "color" },
      "bodyGlow": { "$value": "rgba(125, 103, 44, 0.08)", "$type": "color" }
    },
    "dark": {
      "ink": {
        "950": { "$value": "#08060b", "$type": "color", "$description": "page background" },
        "900": { "$value": "#0d0a12", "$type": "color", "$description": "card" },
        "800": { "$value": "#1c1822", "$type": "color", "$description": "popover / input" },
        "700": { "$value": "#141018", "$type": "color", "$description": "secondary" },
        "600": { "$value": "#24202a", "$type": "color", "$description": "muted" }
      },
      "fg": {
        "default": { "$value": "#ffffff", "$type": "color" },
        "muted": { "$value": "#a8a29e", "$type": "color" },
        "subtle": { "$value": "#76706a", "$type": "color" }
      },
      "brass": {
        "default": { "$value": "#c8a84e", "$type": "color", "$description": "canonical brand brass" },
        "hot": { "$value": "#e8c466", "$type": "color" },
        "deep": { "$value": "#967c38", "$type": "color" }
      },
      "semantic": {
        "warn": { "$value": "#e8b84a", "$type": "color" },
        "danger": { "$value": "#e0574e", "$type": "color" },
        "success": { "$value": "#4ade80", "$type": "color" }
      },
      "hairline": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
      "hairlineBrass": { "$value": "rgba(200, 168, 78, 0.35)", "$type": "color" },
      "bodyGradTop": { "$value": "#09070c", "$type": "color" },
      "bodyGradBottom": { "$value": "#030205", "$type": "color" },
      "bodyGlow": { "$value": "rgba(216, 178, 73, 0.08)", "$type": "color" }
    }
  },
  "font": {
    "mono": {
      "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "$type": "fontFamily",
      "$description": "display, headlines, labels, data",
      "weights": [300, 400, 500, 600, 700, 800]
    },
    "sans": {
      "$value": "'Inter', -apple-system, system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "body copy",
      "weights": [400, 500, 600, 700]
    }
  },
  "tracking": {
    "label": { "$value": "0.2em", "$type": "dimension" },
    "labelWide": { "$value": "0.25em", "$type": "dimension" },
    "tight": { "$value": "-0.03em", "$type": "dimension" }
  }
}
